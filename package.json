{
  "name": "ems-checklist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run compile-schema && next build",
    "start": "node scripts/serve.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "compile-schema": "tsx scripts/compile-schema.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:sync-schema": "tsx scripts/sync-checklists.ts",
    "check": "npm run compile-schema && npm run typecheck",
    "test:e2e": "node tests/e2e.mjs",
    "dev:new-form": "tsx scripts/dev-create-instance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.6",
    "pdfkit": "^0.17.2",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
