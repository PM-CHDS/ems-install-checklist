# --- database -----------------------------------------------------------------
# Any Postgres: the docker-compose service, a Supabase connection string, or RDS.
DATABASE_URL=postgres://ems:ems@localhost:5432/ems

# --- admin --------------------------------------------------------------------
# Password for /admin, and the secret used to sign the admin session cookie.
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# --- links --------------------------------------------------------------------
# Public base URL, used to build the customer links shown in the admin.
PUBLIC_BASE_URL=http://localhost:3000

# --- file storage -------------------------------------------------------------
# local = a mounted disk volume (default). s3 = any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/uploads
MAX_UPLOAD_BYTES=10485760

# Only needed when STORAGE_DRIVER=s3 (MinIO, Supabase Storage, AWS S3):
# S3_BUCKET=ems-checklist
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=uploads
# S3_FORCE_PATH_STYLE=true
